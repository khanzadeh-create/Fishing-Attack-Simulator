 <!DOCTYPE html>
<html lang="fa" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Enter your password - Google Accounts</title>
    <link rel="stylesheet" href="style.css">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500&display=swap" rel="stylesheet">
</head>
<body>
    <div class="container">
        <header>
            <div class="logo">
                <span class="blue">G</span>
                <span class="red">o</span>
                <span class="yellow">o</span>
                <span class="blue">g</span>
                <span class="green">l</span>
                <span class="red">e</span>
            </div>
        </header>

        <main class="card">
            <!-- نمایش ایمیل وارد شده از صفحه قبل -->
            <div class="header-info">
                <img src="https://via.placeholder.com/40" alt="User Icon" class="user-icon" id="user-icon"> 
                <h1>Welcome</h1>
                <p class="user-email" id="user-email">test@example.com</p> 
                <!-- مقدار واقعی توسط جاوااسکریپت پر میشود -->
            </div>

            <form id="password-form" action="../../report/index.html" method="POST">
                <div class="input-field">
                    <input type="password" id="password" name="password" required autofocus>
                    <label for="password">Enter your password</label>
                </div>
                <div class="help-text">
                    <a href="#">Forgot password?</a>
                </div>

                <!-- فیلد مخفی برای ارسال ایمیل به صفحه گزارش -->
                <input type="hidden" id="hidden-email" name="email" value="">

                <div class="actions">
                    <a href="index.html" class="create-account">Sign in with a different account</a> 
                    <!-- لینک بازگشت به صفحه اول -->
                    <button type="submit" class="next-button">Next</button>
                </div>
            </form>
        </main>


        
        <footer>
            <div class="language-selector">
                <select>
                    <option>English (United States)</option>
                </select>
            </div>
            <div class="footer-links">
                <a href="#">Help</a>
                <a href="#">Privacy</a>
                <a href="#">Terms</a>
            </div>
            <div class="educational-warning">
                <p>⚠️ <strong>This is an educational phishing simulator.</strong> This page is part of a cybersecurity project and does not store any data.</p>
            </div>
        </footer>
    </div>

    <script>
        // گرفتن ایمیل از URL و نمایش آن در صفحه
        document.addEventListener('DOMContentLoaded', function() {
            const urlParams = new URLSearchParams(window.location.search);
            const email = urlParams.get('email'); // دریافت ایمیل از پارامتر URL

            const userEmailElement = document.getElementById('user-email');
            const hiddenEmailField = document.getElementById('hidden-email');
            const userIcon = document.getElementById('user-icon');

            if (email) {
                userEmailElement.textContent = email;
                hiddenEmailField.value = email; // پر کردن فیلد مخفی برای ارسال به سرور

                // ساخت یک آواتار ساده بر اساس اولین حرف ایمیل (اختیاری)
                const firstLetter = email.charAt(0).toUpperCase();
                userIcon.src = `https://via.placeholder.com/40/4285F4/FFFFFF?text=${firstLetter}`;
            } else {
                // اگر ایمیلی در URL نبود، کاربر را به صفحه اول برگردان
                window.location.href = 'index.html';
            }
        });
    </script>
</body>
</html>
